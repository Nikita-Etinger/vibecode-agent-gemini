{
  "manifest_version": 3,
  "name": "Local Agent Zero-Click Bridge (chat.z.ai)",
  "version": "1.0",
  "description": "Автономный Zero-Click мост между chat.z.ai и локальным Python-агентом Vibecode",
  "permissions": [
    "contextMenus",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*",
    "https://chat.z.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.z.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
